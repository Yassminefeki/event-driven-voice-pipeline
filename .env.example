# Copy to .env and fill in real values locally. Never commit .env.

# Telegram
TELEGRAM_BOT_TOKEN=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka1:9092,kafka2:9092,kafka3:9092
KAFKA_GROUP_ID_BOT=telegram-bot-group
KAFKA_GROUP_ID_WORKER=asr-worker-group

# MinIO / S3
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=audio-archive
MINIO_SECURE=False

# Whisper ASR
WHISPER_ENDPOINT=

# Elasticsearch
ELASTIC_URL=
ELASTIC_INDEX=transcription.corrected
