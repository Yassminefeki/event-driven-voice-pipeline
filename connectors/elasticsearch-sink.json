{
  "name": "elasticsearch-transcription-sink",
  "config": {
    "connector.class": "io.confluent.kafka.connect.elasticsearch.ElasticsearchSinkConnector",
    "tasks.max": "1",
    "topics": "transcription.corrected",
    "connection.url": "${env:ELASTIC_URL}",
    "key.ignore": "false",
    "schema.ignore": "true",
    "behavior.on.malformed.documents": "fail",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "key.converter.schemas.enable": "false",
    "drop.invalid.message": "false"
  }
}